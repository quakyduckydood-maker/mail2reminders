<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example LaunchAgent generated by:
      mail2reminders install-launchd --times 08:00,20:00

  Prefer the command above: it writes the correct paths for your machine
  and loads the job. This file is here as a reference only.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mail2reminders</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/mail2reminders</string>
    <string>run</string>
    <string>--quiet</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/mail2reminders.out.log</string>
  <key>StandardErrPath</key>
  <string>/tmp/mail2reminders.err.log</string>
</dict>
</plist>
